{
  "name": "filippovicentini.com",
  "version": "4.2.0",
  "description": "Personal Website of Filippo Vicentini",
  "license": "CC BY-SA",
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "run-s clean eleventy:dev --print-label",
    "build": "run-s clean eleventy:prod --print-label workbox",
    "eleventy:dev": "cross-env ELEVENTY_ENV=development eleventy --serve",
    "eleventy:prod": "cross-env ELEVENTY_ENV=production eleventy",
    "workbox": "node utils/workbox.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "debug": "DEBUG=Eleventy* npm start"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/PhilipVinc/filippovicentini.com"
  },
  "author": "Filippo Vicentini",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^1.0.9",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@babel/core": "^7.11.4",
    "@babel/plugin-transform-react-jsx": "^7.12.12",
    "@babel/plugin-transform-runtime": "^7.11.0",
    "@babel/preset-env": "^7.11.0",
    "babel-loader": "^9.1.3",
    "clean-css": "^5.3.3",
    "cross-env": "^7.0.2",
    "cssesc": "^3.0.0",
    "dompurify": "^3.4.17",
    "dotenv": "^8.2.0",
    "eleventy-plugin-share-highlight": "^0.1.4",
    "encoding": "^0.1.13",
    "focus-trap": "^5.1.0",
    "focus-visible": "^5.2.0",
    "html-entities": "^2.5.2",
    "html-minifier-terser": "^7.2.0",
    "infinite-scroll": "^4.0.1",
    "lodash": "^4.17.20",
    "luxon": "^1.28.1",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "memfs": "^4.6.0",
    "node-fetch": "^2.7.0",
    "npm-run-all": "^4.1.5",
    "preact": "^10.5.7",
    "sanitize-html": "^2.3.0",
    "sass": "^1.69.5",
    "slugify": "^1.6.9",
    "svg-sprite": "^2.0.4",
    "webpack": "^5.89.0",
    "workbox-build": "^7.4.1"
  },
  "devDependencies": {
    "eleventy-plugin-mathjax": "^2.0.4",
    "node-pandoc": "^0.3.0"
  }
